#: templates/legal/terms.html:27 templates/legal/terms.html:72
msgid "Starter:"
msgstr "Starter:"

#: templates/legal/terms.html:27
msgid "€ 4,99 pro Monat"
msgstr "4,99 € miesięcznie"

#: templates/legal/terms.html:28 templates/legal/terms.html:73
msgid "Pro:"
msgstr "Pro:"

#: templates/legal/terms.html:28
msgid "€ 9,99 pro Monat"
msgstr "9,99 € miesięcznie"

#: templates/legal/terms.html:29 templates/legal/terms.html:74
msgid "Business:"
msgstr "Business:"

#: templates/legal/terms.html:29
msgid "€ 19,99 pro Monat"
msgstr "19,99 € miesięcznie"

#: templates/legal/terms.html:31
msgid ""
"4.2 Die Abo-Gebühren werden jeweils im Voraus zu Beginn des jeweiligen "
"Abrechnungsmonats fällig und automatisch über den Zahlungsdienstleister "
